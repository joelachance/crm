# Neon Postgres (recommended for production). Neon does not host SQLite; use this Postgres URL when available.
DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech/dbname?sslmode=require"

# Optional: local SQLite file when DATABASE_URL is unset (defaults to .data/era-local.sqlite)
# SQLITE_PATH=".data/era-local.sqlite"

# Name recorded on outreach draft approvals (default: Joe LaChance)
# REVIEWER_NAME="Joe LaChance"

OPENAI_API_KEY="sk-..."
